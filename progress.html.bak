<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>আমার অগ্রগতি - চলো পড়তে বসি</title>
    <link rel="icon" type="image/png" sizes="32x32" href="icons/favicon-32.png">
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#00693E">
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <header>
        <div class="container header-content">
            <h1 class="logo">চলো পড়তে বসি</h1>
            <p class="tagline">আমার অগ্রগতি</p>
        </div>
    </header>

    <main class="container">
        <div class="page-header">
            <a href="index.html" class="back-btn" title="ফিরে যান">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h2 class="section-title">আমার অগ্রগতি</h2>
        </div>

        <!-- Summary Stats -->
        <section class="stats-grid" id="statsGrid">
            <div class="stat-card">
                <div class="stat-card-icon"><i class="fas fa-clipboard-check"></i></div>
                <div class="stat-card-value" id="totalExams">০</div>
                <div class="stat-card-label">মোট পরীক্ষা</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon"><i class="fas fa-trophy"></i></div>
                <div class="stat-card-value" id="bestScore">০%</div>
                <div class="stat-card-label">সেরা স্কোর</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon"><i class="fas fa-chart-line"></i></div>
                <div class="stat-card-value" id="avgScore">০%</div>
                <div class="stat-card-label">গড় স্কোর</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon"><i class="fas fa-fire"></i></div>
                <div class="stat-card-value" id="streakCount">০</div>
                <div class="stat-card-label">দিনের স্ট্রিক</div>
            </div>
        </section>

        <!-- Empty State -->
        <section id="emptyState" class="empty-state hidden">
            <i class="fas fa-clipboard-list"></i>
            <h3>এখনো কোনো পরীক্ষা দেওয়া হয়নি</h3>
            <p>প্রথম পরীক্ষা দিয়ে নিজের অগ্রগতি শুরু করুন</p>
            <a href="exam.html" class="btn-primary" style="display: inline-flex; width: auto; padding: 12px 30px; margin-top: 20px; text-decoration: none;">
                <i class="fas fa-play"></i> পরীক্ষা শুরু করুন
            </a>
        </section>

        <!-- History Section -->
        <section id="historySection" class="history-section hidden">
            <h3 class="section-title" style="text-align: left; margin-top: 30px;">
                <i class="fas fa-history"></i> পরীক্ষার ইতিহাস
            </h3>
            <div id="historyList" class="history-list"></div>
        </section>

        <!-- Reset Button -->
        <section id="resetSection" class="hidden" style="text-align: center; margin-top: 30px;">
            <button id="resetBtn" class="btn-secondary" style="color: #dc2626;">
                <i class="fas fa-trash-alt"></i> সব রেকর্ড মুছে ফেলুন
            </button>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2025 চলো পড়তে বসি। সর্বস্বত্ব সংরক্ষিত।</p>
        </div>
    </footer>

    <script src="js/progress.js"></script>
    <script src="js/onboarding.js"></script>
    <script src="js/pwa.js"></script>
</body>
</html>
